# 复制为 .env，并填入自己的 API Key；已有 .env 时请按需合并。
# 以下变量供 mini-cursor.mjs 使用。
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 使用服务商支持的模型名称；通过第三方网关时同步调整 BASE_URL。
# 官方配置参考：https://api-docs.deepseek.com/
DEEPSEEK_MODEL=deepseek-v4-flash

# 高德 Streamable HTTP MCP：填写高德开放平台的「Web 服务」Key。
# 留空或保持占位值时跳过高德连接；本地示例、filesystem 和 Chrome 仍可使用。
AMAP_MAPS_API_KEY=your-amap-api-key
